+		DWORD ttf = StageStates[s][D3DTSS_TEXTURETRANSFORMFLAGS];
+		const D3DMATRIX &tm = Transforms[D3DTS_TEXTURE0 + s];
+		if (ttf == D3DTTFF_DISABLE) {
