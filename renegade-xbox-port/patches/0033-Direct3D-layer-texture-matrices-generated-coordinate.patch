 			static bool logged;
-			Log_Once(&logged, "texture: coordinate sets above 1 are not supported yet (read as set 0)");
+			Log_Once(&logged, "texture: coordinate sets above 3 (read as set 0)");
 		}
-		if ((tci & 0xFFFF0000) != D3DTSS_TCI_PASSTHRU && Textures[s]) {
