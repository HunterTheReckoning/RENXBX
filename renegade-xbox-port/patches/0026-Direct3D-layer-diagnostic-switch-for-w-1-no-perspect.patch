From 43a50a0019579f3b824b223b21f42bbf7fa05deb Mon Sep 17 00:00:00 2001
From: port <port@local>
Date: Sun, 4 Oct 2026 20:56:49 +0000
Subject: [PATCH 26/32] Direct3D layer: diagnostic switch for w = 1 (no
 perspective correction)

XboxD3D_Set_Diagnostic_W1 makes the vertex program output w = 1, to tell whether the depth
errors seen with crossing planes come from the GPU's perspective correction of a depth value the
program has already divided by w. Off normally; same constant layout, now 51 instructions.
---
 xbox/d3d8/xbox_d3d8.cpp     |  7 +++++++
 xbox/d3d8/xbox_d3d8_stats.h |  4 ++++
 xbox/d3d8/xbox_ffp.vs.cg    |  5 +++--
 xbox/d3d8/xbox_ffp_vs.inl   | 15 ++++++++-------
 4 files changed, 22 insertions(+), 9 deletions(-)

diff --git a/Code/xbox/d3d8/xbox_d3d8.cpp b/Code/xbox/d3d8/xbox_d3d8.cpp
index 5a88bb7..aa248e0 100644
--- a/Code/xbox/d3d8/xbox_d3d8.cpp
+++ b/Code/xbox/d3d8/xbox_d3d8.cpp
@@ -60,6 +60,7 @@ void Free_GPU_Memory(void *memory)
 }
 
 static XboxD3DStats Stats;   /* live objects; see xbox_d3d8_stats.h */
+static bool DiagnosticW1;    /* see XboxD3D_Set_Diagnostic_W1 */
 
 void Log_Once(bool *done, const char *what)
 {
@@ -1388,6 +1389,7 @@ bool Device::Prepare_Draw(UINT base_vertex)
 	c[CONST_FLAGS][3] = (color_vertex && RenderStates[D3DRS_EMISSIVEMATERIALSOURCE] == D3DMCS_COLOR1) ? 1.0f : 0.0f;
 	c[CONST_FLAGS2][0] = (fvf & D3DFVF_DIFFUSE) ? 1.0f : 0.0f;
 	c[CONST_FLAGS2][1] = (fvf & D3DFVF_SPECULAR) ? 1.0f : 0.0f;
+	c[CONST_FLAGS2][2] = DiagnosticW1 ? 1.0f : 0.0f;
 	for (int i = 0; i < 4; i++) {
 		if (!LightEnabled[i]) continue;
 		if (Lights[i].Type != D3DLIGHT_DIRECTIONAL) {
@@ -1602,6 +1604,11 @@ void XboxD3D_Get_Stats(XboxD3DStats *out)
 	if (out) *out = XboxD3D::Stats;
 }
 
+void XboxD3D_Set_Diagnostic_W1(bool on)
+{
+	XboxD3D::DiagnosticW1 = on;
+}
+
 IDirect3D8 *Direct3DCreate8(UINT SDKVersion)
 {
 	if (SDKVersion != D3D_SDK_VERSION) return NULL;
diff --git a/Code/xbox/d3d8/xbox_d3d8_stats.h b/Code/xbox/d3d8/xbox_d3d8_stats.h
index efd3e0a..31c393e 100644
--- a/Code/xbox/d3d8/xbox_d3d8_stats.h
+++ b/Code/xbox/d3d8/xbox_d3d8_stats.h
@@ -15,4 +15,8 @@ struct XboxD3DStats {
 
 void XboxD3D_Get_Stats(XboxD3DStats *out);
 
+/* Diagnostic: when on, the vertex program outputs w = 1, so the GPU applies no perspective
+** correction. Used to tell whether depth problems come from that correction. Off normally. */
+void XboxD3D_Set_Diagnostic_W1(bool on);
+
 #endif
diff --git a/Code/xbox/d3d8/xbox_ffp.vs.cg b/Code/xbox/d3d8/xbox_ffp.vs.cg
index 8352df0..949e458 100644
--- a/Code/xbox/d3d8/xbox_ffp.vs.cg
+++ b/Code/xbox/d3d8/xbox_ffp.vs.cg
@@ -44,7 +44,8 @@ vOut main(
 	uniform float4   ambient_global, /* D3DRS_AMBIENT */
 	uniform float4   flags,          /* x lighting on, y diffuse from vertex, z ambient from vertex,
 	                                    w emissive from vertex */
-	uniform float4   flags2,         /* x vertex has a diffuse color, y has a specular color */
+	uniform float4   flags2,         /* x vertex has a diffuse color, y has a specular color,
+	                                    z diagnostic: output w = 1 (no perspective correction) */
 	uniform float4   light_dir[4],     /* xyz: direction the light travels */
 	uniform float4   light_diffuse[4]  /* rgb; zero for an unused light */
 	)
@@ -52,7 +53,7 @@ vOut main(
 	vOut R;
 
 	float4 p = mul(float4(I.pos.xyz, 1.0), m_screen);
-	R.pos = float4(p.xyz / p.w, p.w);
+	R.pos = float4(p.xyz / p.w, lerp(p.w, 1.0, flags2.z));
 
 	/* Vertex colors default to white when the vertex has none. */
 	float4 vdiff = lerp(float4(1, 1, 1, 1), I.diff, flags2.x);
