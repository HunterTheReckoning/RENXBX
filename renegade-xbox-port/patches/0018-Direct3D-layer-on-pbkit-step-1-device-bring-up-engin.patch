+
+HRESULT VertexBuffer::Lock(UINT OffsetToLock, UINT SizeToLock, BYTE **ppbData, DWORD)
+{
+	if (!ppbData || OffsetToLock > Length || SizeToLock > Length - OffsetToLock) return D3DERR_INVALIDCALL;
+	*ppbData = Memory + OffsetToLock;
+	return D3D_OK;
+}
