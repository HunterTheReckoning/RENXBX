 xbox/d3d8/xbox_d3d8_internal.h  |   78 +++
 xbox/d3d8/xbox_d3dx8.cpp        |  244 +++++++
 xbox/include/xbox_win32_types.h |    5 +
 7 files changed, 1558 insertions(+), 2 deletions(-)
 create mode 100644 ww3d2/animatedsoundmgr_xbox.cpp
